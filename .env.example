# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Shared SQLite database used by both the bot and the admin panel
DATABASE_PATH=./shopkeeper.db

# Folder where product photos are stored/served from
IMAGES_PATH=./photo

# Flask session signing key — use a long random string, keep it secret
SECRET_KEY=change-this-to-a-random-secret-string
